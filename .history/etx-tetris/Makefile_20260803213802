DEST?=_site

all: lua $(DEST)/index.html

_site/index.html: README.md template/template.html template/metadata.yml
	mkdir -p $(DEST)
	pandoc -s $< -c template/mvp.css --metadata-file=template/metadata.yml --template template/template.html -o $@
	cp site/* $(DEST)/

deps: node_modules/.bin/tstl

node_modules/.bin/tstl: package.json
	npm i

lua: deps
	node_modules/.bin/tstl
	mkdir -p $(DEST)/ARAR
	cp -f src/tetris.lua $(DEST)/ARAR/Tetris.lua
	cp -f src/outputs.lua $(DEST)/ARAR/outputs.lua
	cp -f src/timer.lua $(DEST)/ARAR/timer.lua
	cp -f src/gauge.lua $(DEST)/ARAR/gauge.lua
	cp -f src/modelbmp.lua $(DEST)/ARAR/modelbmp.lua
	cp -f src/text.lua $(DEST)/ARAR/text.lua
	cp -f assets/mask_rscale.png $(DEST)/ARAR/
	cp -f assets/mask_timer.png $(DEST)/ARAR/
	cp -f assets/mask_timer_bg.png $(DEST)/ARAR/
	cp -f src/tetris-widget.lua $(DEST)/main.lua

dev:
	find src/ | entr make lua

clean:
	rm -f package-lock.json
	rm -rf $(DEST) node_modules
